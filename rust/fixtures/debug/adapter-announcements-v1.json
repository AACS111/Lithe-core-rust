{
  "schemaVersion": 1,
  "description": "debug.adapters.readAnnouncement: one output line of a tcpAnnounced debug adapter and what Core reads from it. A case without result fails with invalid_request.",
  "cases": [
    {
      "name": "an IPv4 loopback host and port",
      "input": {
        "endpoint": {
          "stream": "stdout",
          "prefix": "DAP server listening at: ",
          "value": "hostPort"
        },
        "stream": "stdout",
        "line": "DAP server listening at: 127.0.0.1:54321"
      },
      "result": {
        "status": "announced",
        "host": "127.0.0.1",
        "port": 54321
      }
    },
    {
      "name": "trailing carriage return and spaces",
      "input": {
        "endpoint": {
          "stream": "stdout",
          "prefix": "DAP server listening at: ",
          "value": "hostPort"
        },
        "stream": "stdout",
        "line": "DAP server listening at: 127.0.0.1:5678 \r"
      },
      "result": {
        "status": "announced",
        "host": "127.0.0.1",
        "port": 5678
      }
    },
    {
      "name": "text before the prefix",
      "input": {
        "endpoint": {
          "stream": "stdout",
          "prefix": "DAP server listening at: ",
          "value": "hostPort"
        },
        "stream": "stdout",
        "line": "2026-11-15T10:00:00Z DAP server listening at: 127.0.0.1:5678"
      },
      "result": {
        "status": "announced",
        "host": "127.0.0.1",
        "port": 5678
      }
    },
    {
      "name": "a bracketed IPv6 loopback address",
