        "endpoint": {
          "stream": "stdout",
          "prefix": "DAP server listening at: ",
          "value": "hostPort"
        },
        "stream": "stdout",
        "line": "DAP server listening at: [::1]:5678"
      },
      "result": {
        "status": "announced",
        "host": "::1",
        "port": 5678
      }
    },
    {
