            "path": "/projects/shop",
            "id": ".",
            "name": "shop",
            "role": "workspace",
            "changes": [
              {
                "path": "modules/payments",
                "status": "M",
                "staged": false,
                "worktree": true,
                "untracked": false,
                "submodule": {
                  "commitChanged": false,
                  "trackedChanges": true,
                  "untrackedChanges": false
                },
                "canToggleStaging": false
              },
              {
                "path": "vendor/tool",
                "status": "M",
                "staged": false,
                "worktree": true,
                "untracked": false,
                "submodule": {
                  "commitChanged": true,
                  "trackedChanges": false,
                  "untrackedChanges": false
                },
                "canToggleStaging": true
              },
              {
                "path": "README.md",
                "status": "M",
                "staged": true,
                "worktree": false,
                "untracked": false,
                "canToggleStaging": true
              },
              {
                "path": "docs/new.md",
                "originalPath": "docs/old.md",
                "status": "R",
                "staged": true,
                "worktree": true,
                "untracked": false,
                "canToggleStaging": true
              }
            ]
          },
          {
            "path": "/projects/shop/extras",
            "id": "extras",
            "name": "extras",
            "role": "nested",
            "changes": [
              {
                "path": "e.txt",
                "status": "??",
                "staged": false,
                "worktree": true,
                "untracked": true,
                "canToggleStaging": true
              }
            ]
          },
          {
            "path": "/projects/shop/modules/payments",
            "id": "modules/payments",
            "name": "modules/payments",
            "role": "nested",
            "changes": [
              {
                "path": "pay.go",
                "status": "M",
                "staged": false,
                "worktree": true,
                "untracked": false,
                "canToggleStaging": true
              }
            ]
          },
          {
            "path": "/projects/shop/vendor/tool",
            "id": "vendor/tool",
            "name": "vendor/tool",
            "role": "nested",
            "changes": [
              {
                "path": "x.c",
                "status": "M",
                "staged": true,
                "worktree": false,
                "untracked": false,
                "canToggleStaging": true
              }
            ]
          }
        ]
      },
      "response": {
        "groups": [
          {
            "id": ".",
            "name": "shop",
            "role": "workspace",
            "fileCount": 4,
            "stagedCount": 2,
            "allStaged": false,
            "toggleable": true,
            "staging": {
              "operation": "stage",
              "paths": [
                "vendor/tool",
                "docs/old.md",
                "docs/new.md"
              ]
            }
          },
          {
            "id": "extras",
            "name": "extras",
            "role": "nested",
            "fileCount": 1,
            "stagedCount": 0,
            "allStaged": false,
            "toggleable": true,
            "staging": {
              "operation": "stage",
              "paths": [
                "e.txt"
              ]
            }
          },
          {
            "id": "modules/payments",
            "name": "modules/payments",
            "role": "nested",
            "fileCount": 1,
            "stagedCount": 0,
            "allStaged": false,
            "toggleable": true,
            "staging": {
              "operation": "stage",
              "paths": [
                "pay.go"
              ]
            },
            "parentReference": "unchanged"
          },
          {
            "id": "vendor/tool",
            "name": "vendor/tool",
            "role": "nested",
            "fileCount": 1,
            "stagedCount": 1,
            "allStaged": true,
            "toggleable": true,
            "staging": {
              "operation": "unstage",
              "paths": [
                "x.c"
              ]
            },
            "parentReference": "moved"
          }
        ],
        "fileCount": 7,
        "stagedCount": 3,
        "allStaged": false,
        "stageAll": {
          "operation": "stage",
          "repositories": [
            {
              "id": ".",
              "paths": [
                "vendor/tool",
                "docs/old.md",
                "docs/new.md"
              ]
            },
            {
              "id": "extras",
              "paths": [
                "e.txt"
              ]
            },
            {
              "id": "modules/payments",
              "paths": [
                "pay.go"
              ]
            }
          ]
        }
      }
    },
