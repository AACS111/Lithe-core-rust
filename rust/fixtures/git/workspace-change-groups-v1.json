{
  "version": 1,
  "description": "git.workspaceChangeGroups takes the workspace.repositories entries unchanged, each with the git.status changes read for it. Groups are the repositories with changes in discovery order. A checkbox unstages every staged change that can toggle when all such changes are staged with nothing left in the worktree, and otherwise stages every change that can toggle and is unstaged or still changed in the worktree; paths list both sides of a rename. The workspace line applies one operation, chosen from all repositories, to every repository with something to write. parentReference is present when the deepest listed ancestor's status lists the repository as a gitlink: moved when its recorded commit changed, unchanged otherwise. An untracked or ignored independent repository has none.",
  "cases": [
    {
      "name": "aFolderWithoutItsOwnRepository",
      "request": {
        "repositories": [
          {
            "path": "/workspace/service-a",
            "id": "service-a",
            "name": "service-a",
            "role": "nested",
            "changes": [
              {
                "path": "a.go",
                "status": "M",
                "staged": false,
                "worktree": true,
                "untracked": false,
                "canToggleStaging": true
              },
              {
                "path": "tmp/",
                "status": "??",
                "staged": false,
                "worktree": true,
                "untracked": true,
                "canToggleStaging": true,
                "untrackedFileCount": 3
              }
            ]
          },
          {
            "path": "/workspace/service-b",
            "id": "service-b",
            "name": "service-b",
            "role": "nested",
            "changes": [
              {
                "path": "main.go",
                "status": "M",
                "staged": true,
                "worktree": false,
                "untracked": false,
                "canToggleStaging": true
              }
            ]
          },
          {
            "path": "/workspace/libs/core",
            "id": "libs/core",
            "name": "libs/core",
            "role": "nested",
            "changes": []
          }
        ]
      },
      "response": {
        "groups": [
          {
            "id": "service-a",
            "name": "service-a",
            "role": "nested",
            "fileCount": 4,
            "stagedCount": 0,
            "allStaged": false,
            "toggleable": true,
            "staging": {
              "operation": "stage",
              "paths": [
                "a.go",
                "tmp/"
              ]
            }
          },
          {
            "id": "service-b",
            "name": "service-b",
            "role": "nested",
            "fileCount": 1,
            "stagedCount": 1,
            "allStaged": true,
            "toggleable": true,
            "staging": {
              "operation": "unstage",
              "paths": [
                "main.go"
              ]
            }
          }
        ],
        "fileCount": 5,
        "stagedCount": 1,
        "allStaged": false,
        "stageAll": {
          "operation": "stage",
          "repositories": [
            {
              "id": "service-a",
              "paths": [
                "a.go",
                "tmp/"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "submoduleReferencesAndIndependentRepositories",
